# Rust build artifacts
/device/firmware/target/
/target/
/node_modules/

# embuild cache (~5 GB of vendored ESP-IDF + tools). Lives under
# /work/.embuild because esp-idf-sys's workspace detection lands here
# once CARGO_WORKSPACE_DIR is pinned to the workspace root.
/.embuild/
/device/.embuild/

# ESP-IDF Component Manager lockfile, generated for each MCU when
# `package.metadata.esp-idf-sys.extra_components` pulls in a remote
# component. Reproducibility is already covered by the explicit
# `version = "..."` pins in firmware/Cargo.toml; the lockfile is just
# build cache.
/components_*.lock
/device/components_*.lock

# Cargo local config. `config.toml` is checked in because it holds the
# shared P4 rustflags / ldproxy / ESP_IDF_VERSION wiring that every
# contributor needs; only truly local/generated state stays ignored.
/device/firmware/.cargo/.local/
/device/firmware/.cargo/credentials.toml

# Tool/editor temp files
*.swp
*.swo
*~
.DS_Store

# VS Code local-only state
.vscode/*.code-workspace
.vscode/settings.local.json
.opencode/

# Logs and local env
*.log
.env
.env.*
!.env.example

# Local xtask temp/cache state
/.xtask/

# Locally-installed JDK + Android SDK (provisioned by
# infra/devcontainer/scripts/install-android-toolchain.sh). ~1.5 GB,
# always reproducible, never checked in.
/.tools/

# Gradle dry-run output from `--write-verification-metadata sha256 --dry-run`.
/companion-apps/android/gradle/verification-metadata.dryrun.xml

# Local map inputs/outputs and device bundles
/data/map-src/*
!/data/map-src/.gitkeep
/data/map-data/*
!/data/map-data/.gitkeep
/device-bundle/

# Legacy local map folder
/data/map/

# Generated runtime map bridge module
/device/core/render-core-wasm/src/generated_map.rs

# Web companion build + test artifacts
/companion-apps/web/.vitest/
/companion-apps/web/test-results/
/companion-apps/web/playwright-report/
/companion-apps/web/e2e-results.json

# Native companion app artifacts
/companion-apps/ios/ESP32MapCompanion.xcodeproj/
/companion-apps/ios/build/
/companion-apps/ios/DerivedData/
/companion-apps/ios/.deriveddata-ios-build/
/companion-apps/ios/.deriveddata-ios-build-nosign/
/.deriveddata-ios-build/
/.deriveddata-ios-build-nosign/
/companion-apps/ios/Config/Signing.local.xcconfig
/companion-apps/android/.gradle/
/companion-apps/android/build/
/companion-apps/android/app/build/
/companion-apps/android/local.properties
