# Copy this file to `.env` and fill in real values.
# `.env` is gitignored so secrets stay local.
#
# Loaded automatically by `cargo xtask i18n-sync …` when present at the
# workspace root.

# OpenAI API key used by `cargo xtask i18n-sync --locale <code>` to
# translate strings from i18n/locales/en.json into other locales.
# Generate one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-proj-replace-me
