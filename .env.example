# Copy this file to `.env` and fill in real values.
# `.env` is gitignored so secrets stay local.
#
# Sourced automatically by the devcontainer post-create script and by
# `cargo xtask i18n-sync …` when present at the workspace root.

# OpenAI API key for machine translation (`cargo xtask i18n-sync`).
# Generate at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-proj-replace-me
