    "home.platformHint.locationDefault" : {
      "comment" : "Hint shown under the 'Allow GPS in background' setting on every browser except Safari/iOS.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطلب متصفحك إذن الموقع. اسمح بذلك حتى تستمر الإرشادات في تتبّع موقعك أثناء بقاء الصفحة في الخلفية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ব্রাউজার অবস্থানের অনুমতি চাইবে। অনুমতি দিন যাতে পেজটি ব্যাকগ্রাউন্ডে থাকলেও নির্দেশনা আপনার অবস্থান অনুসরণ করতে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Browser fragt nach einer Standortberechtigung. Erlauben Sie sie, damit die Navigation Ihre Position weiter verfolgt, während die Seite im Hintergrund ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your browser will ask for location permission. Allow it so guidance keeps tracking your position while the page is in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu navegador te pedirá permiso de ubicación. Permítelo para que la guía siga rastreando tu posición mientras la página está en segundo plano."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرورگر شما اجازهٔ موقعیت مکانی می‌خواهد. آن را مجاز کنید تا راهنمایی هنگام پس‌زمینه بودن صفحه، همچنان موقعیت شما را دنبال کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selain pyytää sijaintilupaa. Salli se, jotta opastus jatkaa sijaintisi seurantaa myös kun sivu on taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre navigateur vous demandera l’autorisation de localisation. Acceptez-la pour que l’orientation continue de suivre votre position pendant que la page est en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ब्राउज़र लोकेशन अनुमति मांगेगा। इसे अनुमति दें ताकि पेज बैकग्राउंड में होने पर भी मार्गदर्शन आपकी स्थिति को ट्रैक करता रहे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser Anda akan meminta izin lokasi. Izinkan agar panduan tetap melacak posisi Anda saat halaman berada di latar belakang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザが位置情報の許可を求めます。ページがバックグラウンドの間も、現在地の追跡を続けるために許可してください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा ब्राउझर स्थानासाठी परवानगी मागेल. मार्गदर्शन तुमचे स्थान पार्श्वभूमीत असतानाही ट्रॅक करत राहण्यासाठी ते परवानगी द्या."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your browser go ask for location permission. Allow am make guidance fit keep tracking your position while page dey background."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu navegador vai pedir permissão de localização. Permita para que as orientações continuem acompanhando sua posição enquanto a página estiver em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузер запросит разрешение на определение местоположения. Разрешите, чтобы навигация продолжала отслеживать вашу позицию, пока страница работает в фоне."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا براؤزر مقام کی اجازت مانگے گا۔ اسے اجازت دیں تاکہ رہنمائی صفحہ پسِ منظر میں ہونے پر بھی آپ کی موجودہ پوزیشن کو ٹریک کرتی رہے۔"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的浏览器将请求定位权限。允许它，这样在页面处于后台时，导航仍会持续跟踪你的当前位置。"
          }
        }
      }
    },
    "home.platformHint.locationSafariIos" : {
      "comment" : "Hint shown under the 'Allow GPS in background' setting when the browser is Safari on iOS.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر Safari على iPhone تحديد GPS في الخلفية بشكل حقيقي. أبقِ علامة التبويب مفتوحة والشاشة قيد التشغيل حتى تستمر تحديثات الموقع أثناء ركوبك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-এর Safari আসল ব্যাকগ্রাউন্ড GPS দেয় না। আপনি যাত্রা করার সময় অবস্থান আপডেট চালু রাখতে ট্যাবটি খোলা রাখুন এবং স্ক্রিন অন রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari auf dem iPhone liefert kein echtes GPS im Hintergrund. Halten Sie den Tab aktiv und den Bildschirm eingeschaltet, damit Standortaktualisierungen während der Fahrt weiter erfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari on iPhone does not deliver true background GPS. Keep the tab active and the screen on so location updates continue while you ride."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari en iPhone no entrega GPS real en segundo plano. Mantén la pestaña activa y la pantalla encendida para que las actualizaciones de ubicación continúen mientras pedaleas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سافاری روی آیفون GPS واقعیِ پس‌زمینه را ارسال نمی‌کند. تب را باز نگه دارید و صفحه روشن باشد تا به‌روزرسانی‌های موقعیت هنگام رکاب‌زنی ادامه پیدا کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonen Safari ei tue oikeaa taustalla toimivaa GPS:ää. Pidä välilehti aktiivisena ja näyttö päällä, jotta sijaintipäivitykset jatkuvat ajon aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari sur iPhone ne fournit pas une localisation GPS réellement en arrière-plan. Gardez l’onglet actif et l’écran allumé pour que les mises à jour de localisation continuent pendant que vous roulez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone पर Safari असली बैकग्राउंड GPS नहीं देता। टैब को सक्रिय रखें और स्क्रीन ऑन रखें ताकि आप सवारी करते समय लोकेशन अपडेट जारी रहें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari di iPhone tidak memberikan GPS latar belakang yang benar. Tetap aktifkan tab dan nyalakan layar agar pembaruan lokasi terus berlanjut saat Anda bersepeda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのSafariは、真のバックグラウンドGPSを提供しません。タブを開いたまま、画面を点けた状態で走ってください。位置情報の更新が続きます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone वरील Safari खरे पार्श्वभूमी GPS देत नाही. तुम्ही राइड करत असताना स्थान अपडेट्स सुरू राहण्यासाठी टॅब सक्रिय ठेवा आणि स्क्रीन चालू ठेवा."
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari for iPhone no dey deliver true background GPS. Keep the tab active and make screen stay on so location updates go continue while you dey ride."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Safari no iPhone não fornece GPS verdadeiro em segundo plano. Mantenha a aba ativa e a tela ligada para que as atualizações de localização continuem enquanto você pedala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari на iPhone не передаёт точные GPS-данные в фоне. Держите вкладку активной и экран включённым, чтобы обновления местоположения продолжались во время поездки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آئی فون پر Safari حقیقی پسِ منظر GPS نہیں دیتا۔ ٹیب کو فعال رکھیں اور اسکرین آن رکھیں تاکہ سواری کے دوران مقام کی اپڈیٹس جاری رہیں۔"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 上的 Safari 无法提供真正的后台 GPS。保持此标签页处于打开状态，并让屏幕保持亮起，以便你骑行时位置更新仍能继续。"
          }
        }
      }
    },
