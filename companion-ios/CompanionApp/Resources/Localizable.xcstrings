    "planning.mixedRoutesFromHslAndOsm" : {
      "comment" : "Notice shown above the route alternatives card when results combine HSL Digitransit and OSM-derived providers. HSL and OSM are brand names — do not translate.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixed routes from HSL and OSM"
          }
        },
        "fi" : {
