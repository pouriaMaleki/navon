{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Map: prepare",
      "type": "shell",
      "command": "cargo xtask prepare-map",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Emulator: ensure deps",
      "type": "shell",
      "command": "bash infra/devcontainer/scripts/ensure-emulator-deps.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Emulator: run",
      "type": "shell",
      "command": "cargo xtask emu",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Emulator: ensure deps"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "emulator",
      "dependsOn": [
        "Emulator: run"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Device: bundle",
      "type": "shell",
      "command": "cargo xtask bundle-device --release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Device: bundle (clean)",
      "type": "shell",
      "command": "cargo clean -p esp-idf-sys --target riscv32imafc-esp-espidf --release && cargo clean -p firmware --target riscv32imafc-esp-espidf --release && rm -rf target/devcontainer/riscv32imafc-esp-espidf/release/build/esp-idf-sys-*/out/build && cargo xtask bundle-device --release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Clean rebuild: drops esp-idf-sys, firmware, and the CMake build dir before bundling. Use when sdkconfig or extra_components changes don't seem to land. Takes ~2-3 minutes."
    },
    {
      "label": "Device: deploy",
      "type": "shell",
      "command": "cargo xtask deploy-device --port ${input:esp_port}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: install toolchain",
      "type": "shell",
      "command": "bash infra/devcontainer/scripts/install-android-toolchain.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "detail": "Idempotent: installs Temurin JDK 21 + Android SDK (platform-35, build-tools 35) under /work/.tools and appends env to ~/.bashrc. Skip when already installed."
    },
    {
      "label": "Android: assemble debug",
      "type": "shell",
      "command": "./gradlew :app:assembleDebug",
      "options": {
        "cwd": "${workspaceFolder}/companion-android",
        "env": {
          "JAVA_HOME": "/work/.tools/jdk-21.0.11+10",
          "ANDROID_HOME": "/work/.tools/android-sdk",
          "PATH": "/work/.tools/jdk-21.0.11+10/bin:/work/.tools/android-sdk/cmdline-tools/latest/bin:/work/.tools/android-sdk/platform-tools:${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "dependsOn": [
        "Android: install toolchain"
      ],
      "dependsOrder": "sequence",
      "detail": "Builds companion-android/app/build/outputs/apk/debug/app-debug.apk (~70 s clean, ~10 s incremental)."
    },
    {
      "label": "Android: assemble release",
      "type": "shell",
      "command": "./gradlew :app:assembleRelease",
      "options": {
        "cwd": "${workspaceFolder}/companion-android",
        "env": {
          "JAVA_HOME": "/work/.tools/jdk-21.0.11+10",
          "ANDROID_HOME": "/work/.tools/android-sdk",
          "PATH": "/work/.tools/jdk-21.0.11+10/bin:/work/.tools/android-sdk/cmdline-tools/latest/bin:/work/.tools/android-sdk/platform-tools:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "dependsOn": [
        "Android: install toolchain"
      ],
      "dependsOrder": "sequence",
      "detail": "Unsigned release APK; will need a real signing config before publishing."
    },
    {
      "label": "Android: lint + compile",
      "type": "shell",
      "command": "./gradlew :app:compileDebugKotlin :app:lintDebug",
      "options": {
        "cwd": "${workspaceFolder}/companion-android",
        "env": {
          "JAVA_HOME": "/work/.tools/jdk-21.0.11+10",
          "ANDROID_HOME": "/work/.tools/android-sdk",
          "PATH": "/work/.tools/jdk-21.0.11+10/bin:/work/.tools/android-sdk/cmdline-tools/latest/bin:/work/.tools/android-sdk/platform-tools:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "dependsOn": [
        "Android: install toolchain"
      ],
      "dependsOrder": "sequence",
      "detail": "Faster gate when iterating: compiles Kotlin and runs Android Lint without packaging an APK."
    },
    {
      "label": "Android: clean",
      "type": "shell",
      "command": "./gradlew clean",
      "options": {
        "cwd": "${workspaceFolder}/companion-android",
        "env": {
          "JAVA_HOME": "/work/.tools/jdk-21.0.11+10",
          "ANDROID_HOME": "/work/.tools/android-sdk",
          "PATH": "/work/.tools/jdk-21.0.11+10/bin:/work/.tools/android-sdk/cmdline-tools/latest/bin:/work/.tools/android-sdk/platform-tools:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "detail": "Drops companion-android/build and companion-android/app/build."
    }
  ],
  "inputs": [
    {
      "id": "esp_port",
      "type": "promptString",
      "description": "ESP serial port (example: /dev/ttyUSB0)",
      "default": "/dev/ttyUSB0"
    }
  ]
}
