<script>
  const carousel = document.getElementById("carousel")!;
  let timeout: ReturnType<typeof setTimeout> | null = null;

  function cardWidth() {
    const card = carousel.querySelector(".card");
    return card?.getBoundingClientRect().width ?? 260;
  }

  function advance() {
    const gap = parseFloat(getComputedStyle(carousel).gap) || 0;
    const step = cardWidth() + gap;
    const maxLeft = carousel.scrollWidth - carousel.clientWidth;
    let next = carousel.scrollLeft + step;
    if (next >= maxLeft - 2) next = 0;
    carousel.scrollTo({ left: next, behavior: "smooth" });
    scheduleAuto();
  }

  function scheduleAuto() {
    if (timeout) clearTimeout(timeout);
    timeout = setTimeout(advance, 4000);
  }

  carousel.addEventListener("scroll", () => scheduleAuto(), { passive: true });
  carousel.addEventListener("touchstart", () => scheduleAuto());
  carousel.addEventListener("wheel", () => scheduleAuto());

  scheduleAuto();
</script>

