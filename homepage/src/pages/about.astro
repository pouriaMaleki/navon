---
import Footer from "../components/Footer.astro";
import Base from "../layouts/Base.astro";
---

<Base title="About Navon">
  <header class="page-header">
    <a href="/" class="home-link" aria-label="Navon home">
      <img src="/icon.svg" alt="" width="28" height="28" class="icon" />
      <span class="brand">Navon</span>
    </a>
  </header>
  <section class="page">
    <div class="content">
      <h1>About Navon</h1>

      <h2>Free and open-source</h2>
      <p>
        Navon is free software, licensed under the
        <a
          href="https://github.com/pouriaMaleki/navon/blob/main/LICENSE"
          target="_blank"
          rel="noopener"
        >GNU Affero General Public License v3.0</a
        >. There are no paid tiers, no subscriptions, and no premium
        features locked behind a purchase. The entire app — every feature,
        every platform — is free.
      </p>

      <h2>No tracking, no ads, no accounts</h2>
      <p>
        Navon does not track you. It has no analytics, no advertising, and
        no user accounts. You open the app, plan a route, and ride. That&#8217;s it.
      </p>

      <h2>Community</h2>
      <p>
        Navon is developed in the open on
        <a
          href="https://github.com/pouriaMaleki/navon"
          target="_blank"
          rel="noopener"
        >GitHub</a
        >. Contributions of every kind are welcome — code, design, testing,
        translations, documentation, bug reports. If you ride a bike and
        want to help make bike navigation better, there&#8217;s a place for you.
      </p>
      <p>
        <a
          href="https://github.com/pouriaMaleki/navon"
          target="_blank"
          rel="noopener"
          class="cta-link"
        >
          <svg class="gh-icon" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
          Contribute on GitHub
        </a>
      </p>
    </div>
  </section>
  <Footer />
</Base>

<style>
  html {
    scroll-snap-type: none;
  }

  .page-header {
    display: flex;
    justify-content: center;
    padding: var(--space-xl) var(--section-pad-x) var(--space-md);
    background: var(--color-bg);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-fg);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .home-link:hover,
  .home-link:focus-visible {
    opacity: 0.7;
  }

  .home-link img {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
  }

  .page {
    min-height: auto;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-xl) var(--section-pad-x) var(--section-pad-y);
    scroll-snap-align: none;
  }

  .content {
    max-width: var(--content-max);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-fg);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    color: var(--color-fg);
    margin-top: var(--space-md);
  }

  p {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
  }

  a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  a:hover,
  a:focus-visible {
    color: var(--color-fg);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    text-decoration: none;
    transition:
      background var(--dur-fast) var(--ease-out);
  }

  .cta-link:hover,
  .cta-link:focus-visible {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .gh-icon {
    flex-shrink: 0;
  }
</style>
