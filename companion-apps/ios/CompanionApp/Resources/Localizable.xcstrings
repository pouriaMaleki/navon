        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientação do telefone pronta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово голосовое сопровождение"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون رہنمائی تیار ہے"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "手机导航已就绪"
          }
        }
      }
    },
    "home.platformHint.locationDefault": {
      "comment": "Hint shown under the 'Allow GPS in background' setting on every browser except Safari/iOS. Phrased platform-neutrally (no 'browser' / 'page') so it can be reused on iOS and Android in future without sounding off.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُطلب منك إذن الموقع. اسمح بذلك حتى تستمر الإرشادات في تتبّع موقعك أثناء بقاء التطبيق في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অবস্থানের অনুমতি চাওয়া হবে। অনুমতি দিন যাতে অ্যাপটি ব্যাকগ্রাউন্ডে থাকলেও নির্দেশনা আপনার অবস্থান অনুসরণ করতে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden nach einer Standortberechtigung gefragt. Erlauben Sie sie, damit die Navigation Ihre Position weiter verfolgt, während die App im Hintergrund ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be asked for location permission. Allow it so guidance keeps tracking your position when the app is in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te pedirá permiso de ubicación. Permítelo para que la guía siga rastreando tu posición mientras la app está en segundo plano."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازهٔ موقعیت مکانی از شما خواسته می‌شود. آن را مجاز کنید تا راهنمایی هنگام پس‌زمینه بودن برنامه، همچنان موقعیت شما را دنبال کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintilupaa pyydetään. Salli se, jotta opastus jatkaa sijaintisi seurantaa myös kun sovellus on taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation de localisation vous sera demandée. Acceptez-la pour que l’orientation continue de suivre votre position lorsque l’application est en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपसे लोकेशन की अनुमति मांगी जाएगी। इसे अनुमति दें ताकि ऐप बैकग्राउंड में होने पर भी मार्गदर्शन आपकी स्थिति को ट्रैक करता रहे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan diminta memberikan izin lokasi. Izinkan agar panduan tetap melacak posisi Anda saat aplikasi berada di latar belakang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の許可を求められます。アプリがバックグラウンドの間も、現在地の追跡を続けるために許可してください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्याकडून स्थानासाठी परवानगी मागितली जाईल. मार्गदर्शन तुमचे स्थान ॲप पार्श्वभूमीत असतानाही ट्रॅक करत राहण्यासाठी ते परवानगी द्या."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem go ask you for location permission. Allow am make guidance fit keep tracking your position when the app dey background."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Será pedida permissão de localização. Permita para que as orientações continuem acompanhando sua posição enquanto o app estiver em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас запросят разрешение на определение местоположения. Разрешите, чтобы навигация продолжала отслеживать вашу позицию, пока приложение работает в фоне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سے مقام کی اجازت مانگی جائے گی۔ اسے اجازت دیں تاکہ ایپ پسِ منظر میں ہونے پر بھی رہنمائی آپ کی موجودہ پوزیشن کو ٹریک کرتی رہے۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会请求定位权限。允许它，这样在应用处于后台时，导航仍会持续跟踪你的当前位置。"
          }
        }
      }
    },
    "home.platformHint.locationSafariIos": {
      "comment": "Hint shown under the 'Allow GPS in background' setting when the browser is Safari on iOS.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ Safari على iPhone تقديم GPS في الخلفية أو إرشادات شاشة القفل أو تلميحات صوتية أثناء إخفاء علامة التبويب. للحصول على توجيه في الخلفية بشكل حقيقي، ثبّت تطبيق iOS الأصلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-এ Safari ব্যাকগ্রাউন্ডে GPS পাঠাতে পারে না, লক-স্ক্রিনে দিকনির্দেশনা দেখাতে পারে না, বা ট্যাব লুকানো থাকলে অডিও সংকেত দিতে পারে না। সত্যিকারের ব্যাকগ্রাউন্ড রাউটিংয়ের জন্য নেটিভ iOS অ্যাপ ইনস্টল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari auf dem iPhone kann keine GPS-Daten im Hintergrund liefern, keine Hinweise auf dem Sperrbildschirm anzeigen oder Audio-Hinweise ausgeben, solange der Tab ausgeblendet ist. Für echtes Routing im Hintergrund installiere die native iOS-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari on iPhone cannot deliver background GPS, lock-screen guidance, or audio cues while the tab is hidden. For real background routing, install the native iOS app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari en iPhone no puede enviar GPS en segundo plano, indicaciones en la pantalla de bloqueo ni avisos de audio mientras la pestaña está oculta. Para un enrutamiento real en segundo plano, instala la app nativa de iOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سافاری در آیفون نمی‌تواند GPS پس‌زمینه، راهنمایی روی صفحه‌قفل، یا نشانه‌های صوتی را در حالی که تب پنهان است ارسال کند. برای مسیریابی واقعی در پس‌زمینه، اپ بومی iOS را نصب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonen Safari ei pysty välittämään taustalla GPS-sijaintia, lukitusnäytön ohjeita tai ääniopastusta, kun välilehti on piilossa. Aitoa taustareititystä varten asenna natiivi iOS-sovellus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari sur iPhone ne peut pas fournir de GPS en arrière-plan, ni d’instructions sur l’écran de verrouillage, ni d’alertes audio lorsque l’onglet est masqué. Pour un guidage en arrière-plan réel, installez l’application iOS native."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर Safari पृष्ठभूमि GPS, लॉक-स्क्रीन मार्गदर्शन, या ऑडियो संकेत नहीं दे सकता जब टैब छिपा हो। वास्तविक पृष्ठभूमि रूटिंग के लिए, मूल iOS ऐप इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari di iPhone tidak dapat mengirim GPS latar belakang, panduan di layar kunci, atau isyarat audio saat tab disembunyikan. Untuk penelusuran rute latar belakang yang sebenarnya, instal aplikasi iOS asli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのSafariでは、タブが非表示の間にバックグラウンドGPS、ロック画面での案内、または音声の合図を配信できません。バックグラウンドでのルーティングには、ネイティブのiOSアプリをインストールしてください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone वरील Safari पार्श्वभूमीतील GPS देऊ शकत नाही, लॉक-स्क्रीन मार्गदर्शन किंवा ऑडिओ संकेत देऊ शकत नाही, जेव्हा टॅब लपलेला असतो. खऱ्या पार्श्वभूमी रूटिंगसाठी, मूळ iOS अॅप इन्स्टॉल करा."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari wey dey iPhone no fit send GPS for background, guidance for lock-screen, or audio cues while tab don hide. For real background routing, install the native iOS app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Safari no iPhone não consegue fornecer GPS em segundo plano, orientações na tela de bloqueio ou avisos de áudio enquanto a aba estiver oculta. Para roteamento real em segundo plano, instale o app nativo do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari на iPhone не может передавать GPS в фоновом режиме, подсказки на экране блокировки или аудиосигналы, пока вкладка скрыта. Для реальной навигации в фоне установите нативное приложение для iOS."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون پر Safari پس منظر میں GPS، لاک اسکرین رہنمائی، یا آڈیو اشارے اس وقت نہیں دے سکتا جب ٹیب چھپا ہو۔ حقیقی پس منظر میں روٹنگ کے لیے، مقامی iOS ایپ انسٹال کریں۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的 Safari 无法在后台提供 GPS、锁屏导航或音频提示；当标签页被隐藏时尤其如此。要实现真正的后台路线导航，请安装原生 iOS 应用。"
          }
        }
      }
    },
