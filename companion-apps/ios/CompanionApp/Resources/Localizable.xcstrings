    "settings.restartRequired.message": {
      "comment": "Body of an alert shown after switching app language on iOS.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق التطبيق وأعد فتحه لتطبيق اللغة الجديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ভাষা প্রয়োগ করতে অ্যাপটি বন্ধ করে আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die App und öffne sie erneut, um die neue Sprache zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit and reopen the app to apply the new language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra y vuelve a abrir la app para aplicar el nuevo idioma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه را ببندید و دوباره باز کنید تا زبان جدید اعمال شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopeta ja avaa sovellus uudelleen ottaaksesi uuden kielen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez puis rouvrez l’application pour appliquer la nouvelle langue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई भाषा लागू करने के लिए ऐप बंद करें और फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dan buka kembali aplikasi untuk menerapkan bahasa baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを終了して再度開き、新しい言語を適用してください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन भाषा लागू करण्यासाठी अॅप बंद करून पुन्हा उघडा."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Close am make you open the app back so new language fit work."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche e reabra o app para aplicar o novo idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите из приложения и откройте его заново, чтобы применить новый язык."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ بند کریں اور دوبارہ کھولیں تاکہ نئی زبان لاگو ہو جائے۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "退出并重新打开应用以应用新语言。"
          }
        }
      }
    },
