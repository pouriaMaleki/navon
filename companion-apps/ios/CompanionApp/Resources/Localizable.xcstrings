    "cue.arrived": {
      "comment": "Voice cue spoken on arrival at the destination.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد وصلت إلى وجهتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি গন্তব্যে পৌঁছেছেন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind an Ihrem Ziel angekommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have arrived at your destination"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has llegado a tu destino"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به مقصد رسیدید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saapunut määränpäähäsi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes arrivé à destination"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपने गंतव्य पर पहुँच गए हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah tiba di tujuan Anda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的地に到着しました"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तुमच्या गंतव्यस्थानी पोहोचलात"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetin you reach your destination"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você chegou ao seu destino"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы прибыли в пункт назначения"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنے منزل پر پہنچ گئے ہیں"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已到达目的地"
          }
        }
      }
    },
    "cue.arrivingInM": {
      "comment": "Voice cue announcing imminent arrival at the destination.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاقتراب من وجهتك خلال {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার গন্তব্যে পৌঁছাতে আর {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommst in {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}} an deinem Ziel an"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriving at your destination in {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegas a tu destino en {distance, number} {distanceUnit, select, meters {meters} feet {feet} other {meters}}"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در {distance, number} {distanceUnit, select, meters {meters} feet {feet} other {meters}} به مقصد می‌رسید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saavut määränpäähäsi {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}} kuluttua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivée à votre destination dans {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने गंतव्य पर {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}} में पहुंच रहे हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiba di tujuan Anda dalam {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的地に到着まで {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}} です"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या गंतव्यस्थानी {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}} मध्ये पोहोचत आहात"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "You dey arrive your destination for {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegando ao seu destino em {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибытие к месту назначения через {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}}"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے منزلِ مقصود پر پہنچ رہے ہیں {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}} میں"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在 {distance, number} {distanceUnit, select, meters {meters} feet {feet} kilometers {kilometers} other {meters}} 内到达目的地"
          }
        }
      }
    },
