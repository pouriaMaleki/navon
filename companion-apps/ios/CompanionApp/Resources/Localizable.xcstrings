    "home.iosLocationHint": {
      "comment": "Hint shown under 'Allow GPS in background' on iOS when the OS authorisation is still 'When in use'.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات iOS → الخصوصية → الموقع لتبديل هذا التطبيق إلى \"دائمًا\"."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS সেটিংস খুলুন → Privacy → Location, যাতে এই অ্যাপটি \"Always\" করা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne iOS-Einstellungen → Datenschutz → Standort, um diese App auf „Immer“ umzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open iOS Settings → Privacy → Location to switch this app to \"Always\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes de iOS → Privacidad → Ubicación para cambiar esta app a \"Siempre\"."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر این برنامه به «همیشه»، تنظیمات iOS را باز کنید: Privacy → Location."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa iOS-asetukset → Yksityisyys → Sijainti ja vaihda tämän sovelluksen asetukseksi \"Aina\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les Réglages iOS → Confidentialité → Localisation pour passer cette application en « Toujours ». "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स खोलें → Privacy → Location ताकि इस ऐप को \"Always\" पर स्विच किया जा सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan iOS → Privasi → Lokasi untuk mengubah aplikasi ini menjadi \"Selalu\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定を開く → プライバシー → 位置情報で、このアプリを「常に」に切り替えてください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्ज उघडा → गोपनीयता → स्थान, आणि हा अॅप “Always” (नेहमी) वर स्विच करा."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Ṣí iOS Settings → Privacy → Location kí o yí app yi sí \"Always\"."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra as Configurações do iOS → Privacidade → Localização para mudar este app para \"Sempre\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте iOS «Настройки» → «Конфиденциальность» → «Геолокация», чтобы переключить это приложение на «Всегда»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS سیٹنگز کھولیں → پرائیویسی → لوکیشن تاکہ اس ایپ کو \"ہمیشہ\" پر سوئچ کیا جا سکے۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 iOS 设置 → 隐私 → 位置，将此应用切换为“始终”。"
          }
        }
      }
    },
