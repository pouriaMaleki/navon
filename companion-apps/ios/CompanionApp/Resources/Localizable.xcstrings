    "settings.device.forget.confirmMessage": {
      "comment": "Body of the 'Forget this device?' confirmation alert.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتاج إلى مسح رمز الاقتران مرة أخرى لاستخدامه. تبقى سجلات مسارك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ব্যবহার করতে আপনাকে আবার জোড়ার কোড স্ক্যান করতে হবে। আপনার রুটের ইতিহাস অপরিবর্তিত থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst den Kopplungscode erneut scannen, um ihn zu verwenden. Deine Routenhistorie bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to scan the pairing code again to use it. Your route history stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitarás volver a escanear el código de emparejamiento para usarlo. Tu historial de rutas se mantiene."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده دوباره باید کد جفت‌سازی را اسکن کنید. تاریخچه مسیر شما باقی می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun täytyy skannata paritus-QR uudelleen käyttääksesi sitä. Reittihistoriasi säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez à nouveau scanner le code de couplage pour l’utiliser. Votre historique d’itinéraires reste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे फिर से उपयोग करने के लिए आपको पेयरिंग कोड फिर से स्कैन करना होगा। आपका रूट इतिहास बना रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda perlu memindai kode pasangan lagi untuk menggunakannya. Riwayat rute Anda tetap ada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度ペアリングコードを読み取って使用する必要があります。ルート履歴は保持されます。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते वापरण्यासाठी तुम्हाला पुन्हा पेअरिंग कोड स्कॅन करावा लागेल. तुमचा रूट इतिहास तसाच राहील."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Bí o bá fẹ́ lo amúlò rẹ̀ lẹ́ẹ̀kansi, o ní láti scan kòdù pẹ̀lú ìbámu náà mọ́. Ìtàn ọ̀nà rẹ̀ kì yí padà."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisará escanear o código de pareamento novamente para usá-lo. Seu histórico de rotas permanece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам нужно будет снова отсканировать код сопряжения, чтобы использовать его. История маршрутов сохранится."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے دوبارہ استعمال کرنے کے لیے آپ کو جوڑی بنانے کا کوڈ دوبارہ اسکین کرنا ہوگا۔ آپ کی روٹ ہسٹری برقرار رہے گی۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "要再次使用它，你需要重新扫描配对码。你的路线历史会保留。"
          }
        }
      }
    },
