    "settings.voiceNotInstalled": {
      "comment": "Hint shown in Settings when no TTS voice is available for the active locale.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تثبيت صوت {language}. افتح إعدادات النظام لتثبيته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "{language}-এর জন্য ভয়েস ইনস্টল করা নেই। ইনস্টল করতে সিস্টেম সেটিংস খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimme für {language} ist nicht installiert. Öffne die Systemeinstellungen, um sie zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice for {language} is not installed. Open system Settings to install it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se instaló la voz para {language}. Abre los Ajustes del sistema para instalarla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدا برای {language} نصب نشده است. تنظیمات سیستم را باز کنید تا آن را نصب کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhe {language} ei ole asennettu. Avaa järjestelmäasetukset ja asenna se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix pour {language} n’est pas installée. Ouvrez les Paramètres système pour l’installer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{language} के लिए आवाज़ इंस्टॉल नहीं है। इंस्टॉल करने के लिए सिस्टम सेटिंग्स खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara untuk {language} belum terpasang. Buka Pengaturan sistem untuk menginstalnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{language} の音声がインストールされていません。システムの設定を開いてインストールしてください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "{language} साठीचा आवाज स्थापित नाही. तो स्थापित करण्यासाठी सिस्टम सेटिंग्ज उघडा."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice for {language} no dey installed. Open system Settings make you install am."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz para {language} não está instalada. Abra as Configurações do sistema para instalá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос для {language} не установлен. Откройте системные «Настройки», чтобы установить его."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "{language} کے لیے آواز نصب نہیں ہے۔ اسے نصب کرنے کے لیے سسٹم سیٹنگز کھولیں۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 {language} 的语音。打开系统设置以安装。"
          }
        }
      }
    },
