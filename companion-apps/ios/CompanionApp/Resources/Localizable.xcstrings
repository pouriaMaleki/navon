    "settings.language.noVoiceFallback": {
      "comment": "Warning shown under the Language picker when the active locale has no matching TTS voice. {language} is the native name of the picked language. Used on web (browser), iOS, and Android — keep the wording platform-neutral.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتوفر على جهازك صوت لـ {language}. سيتم تشغيل الإشارات الصوتية باللغة الإنجليزية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডিভাইসে {language}-এর জন্য কোনো ভয়েস ইনস্টল করা নেই। অডিও সংকেত ইংরেজিতে বাজবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für {language} ist keine Stimme auf deinem Gerät installiert. Audiohinweise werden auf Englisch abgespielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device has no voice installed for {language}. Audio cues will play in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una voz instalada en tu dispositivo para {language}. Las señales de audio se reproducirán en inglés."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای {language} صدایی روی دستگاه شما نصب نشده است. نشانه‌های صوتی به انگلیسی پخش می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteellesi ei ole asennettu ääntä kielelle {language}. Ääniopastus puhuu englanniksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune voix installée sur votre appareil pour {language}. Les indications audio seront en anglais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस में {language} के लिए कोई वॉइस इंस्टॉल नहीं है। ऑडियो संकेत अंग्रेज़ी में चलेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat Anda tidak memiliki suara yang terpasang untuk {language}. Isyarat audio akan diputar dalam bahasa Inggris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには {language} の音声がインストールされていません。音声案内は英語で再生されます。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या डिव्हाइसवर {language} साठी आवाज स्थापित नाही. ऑडिओ संकेत इंग्रजीत वाजतील."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Kò sí ohùn tí a fi sílẹ̀ fún {language} nínú ẹrọ rẹ. A ó máa gbọ́ ohun ní Gẹ̀ẹ́sì."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dispositivo não tem uma voz instalada para {language}. Os avisos de áudio serão reproduzidos em inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем устройстве нет установленного голоса для {language}. Звуковые подсказки будут воспроизводиться на английском."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے آلے میں {language} کے لیے کوئی آواز نصب نہیں ہے۔ آڈیو اشارے انگریزی میں چلیں گے۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设备未为 {language} 安装语音。音频提示将以英语播放。"
          }
        }
      }
    },
