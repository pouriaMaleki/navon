    "pairing.intro": {
      "comment": "Body text on the pairing intro screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ هاتفك بحيث تكون شاشة الجهاز داخل الإطار، ثم اضغط على ابدأ عندما ترى رمز QR."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসটির স্ক্রিন ফ্রেমে আছে এমনভাবে আপনার ফোনটি ধরুন, তারপর QR কোড দেখলে Start-এ ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte dein Telefon so, dass der Bildschirm des Geräts im Bild ist, und tippe dann auf „Start“, wenn du den QR-Code siehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your phone so the device's screen is in frame, then tap Start when you see the QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén el teléfono para que la pantalla del dispositivo esté dentro del encuadre y, luego, toca Iniciar cuando veas el código QR."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی‌تان را طوری نگه دارید که صفحه‌نمایش دستگاه داخل کادر باشد، سپس وقتی کد QR را دیدید روی Start بزنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä puhelinta niin, että laitteen näyttö on kuvassa, ja napauta sitten Aloita, kun näet QR-koodin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez votre téléphone pour que l’écran de l’appareil soit dans le cadre, puis appuyez sur Démarrer lorsque vous voyez le code QR."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फोन को ऐसे पकड़ें कि डिवाइस की स्क्रीन फ्रेम में रहे, फिर QR कोड दिखने पर Start पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang ponsel Anda agar layar perangkat terlihat dalam bingkai, lalu ketuk Mulai saat Anda melihat kode QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の画面がフレーム内に入るようにスマホを構え、QRコードが見えたら「開始」をタップしてください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन डिव्हाइसच्या स्क्रीनचा भाग फ्रेममध्ये येईल अशा प्रकारे धरा, आणि QR कोड दिसल्यावर Start वर टॅप करा."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Mu fón rẹ kí iboju ẹrọ náà wà nínú fireemu, lẹ́yìn náà tẹ Start nígbà tí o bá rí QR code náà."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o celular para que a tela do dispositivo fique no quadro e, em seguida, toque em Iniciar quando você vir o código QR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднесите телефон так, чтобы экран устройства был в кадре, затем нажмите «Начать», когда увидите QR-код."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا فون اس طرح رکھیں کہ ڈیوائس کی اسکرین فریم میں ہو، پھر جب آپ کو QR کوڈ نظر آئے تو Start پر ٹیپ کریں۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机对准设备屏幕，使其出现在画面中，然后在看到二维码时点击“开始”。"
          }
        }
      }
    },
