    "settings.activity.audioCuesOnlyInBackground.subtitle": {
      "comment": "Toggle subtitle for the audio-cues-only-in-background setting.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، تُشغَّل الإشارات أيضًا عندما يكون التطبيق مفتوحًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ থাকলে, অ্যাপ খোলা থাকলেও সংকেতগুলো বাজে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, werden die Hinweise auch abgespielt, während die App geöffnet ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, cues also play while you have the app open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, los avisos también se reproducen mientras tienes la app abierta"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی خاموش باشد، نشانه‌ها هم‌زمان با باز بودن برنامه هم پخش می‌شوند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun pois käytöstä, äänimerkit kuuluvat myös kun sovellus on avoinna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : les indications sont aussi diffusées quand l’application est ouverte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, संकेत तब भी चलेंगे जब ऐप खुला हो"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat mati, isyarat juga diputar saat Anda membuka aplikasi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、アプリを開いている間も案内が流れます"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद असल्यास, अ‍ॅप उघडे असतानाही संकेत वाजतात"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, cues go still play while you open the app"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desligado, os avisos também são reproduzidos enquanto você tem o app aberto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, подсказки звучат и когда приложение открыто"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب بند ہو تو اشارے تب بھی چلتے ہیں جب آپ کے پاس ایپ کھلی ہو"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后：当你打开应用时也会播放提示"
          }
        }
      }
    },
