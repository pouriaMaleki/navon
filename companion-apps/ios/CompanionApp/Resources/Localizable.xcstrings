    "settings.routePlanner.riding.footnote": {
      "comment": "Footnote under the Riding section explaining cycling-speed override.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز سرعة الدراجة تقديرات HSL ETAs (تكون افتراضات Digitransit لسرعة دراجة بطيئة). وحدة السرعة هي كيفية عرض شارة السرعة المباشرة على الخريطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইক্লিং গতি HSL-এর ETA ওভাররাইড করে (Digitransit ডিফল্টভাবে ধীর সাইকেল গতি ধরে)। গতি একক হলো মানচিত্রে লাইভ-স্পিড ব্যাজ কীভাবে দেখানো হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrgeschwindigkeit überschreibt die HSL-ETAs (Digitransit verwendet standardmäßig eine langsame Fahrradgeschwindigkeit). Die Geschwindigkeitseinheit bestimmt, wie die Live-Geschwindigkeitsanzeige auf der Karte dargestellt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycling speed overrides HSL ETAs (Digitransit defaults to a slow bike speed). Speed unit is how the live-speed badge is shown on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad de ciclismo anula las ETA de HSL (Digitransit usa una velocidad de bicicleta lenta de forma predeterminada). La unidad de velocidad es cómo se muestra la insignia de velocidad en el mapa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعت دوچرخه‌سواری، ETAهای HSL را بازنویسی می‌کند (به‌صورت پیش‌فرض Digitransit سرعت دوچرخه کندتری در نظر می‌گیرد). واحد سرعت مشخص می‌کند که نشانگر سرعتِ زنده روی نقشه چگونه نمایش داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyöräilyn nopeus ohittaa HSL:n ETA-arviot (Digitransit käyttää oletuksena hidasta pyöränopeutta). Nopeusyksikkö määrittää, miten reaaliaikaisen nopeuden tunniste näytetään kartalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse à vélo remplace les ETA HSL (Digitransit utilise une vitesse vélo lente par défaut). L’unité de vitesse sert à afficher le badge de vitesse en direct sur la carte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइक्लिंग गति HSL ETAs को ओवरराइड करती है (Digitransit डिफ़ॉल्ट रूप से धीमी बाइक गति मानता है)। गति की इकाई यह तय करती है कि मैप पर लाइव-गति बैज कैसे दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan bersepeda menimpa Perkiraan Waktu Kedatangan (ETA) HSL (Digitransit default ke kecepatan sepeda yang lambat). Satuan kecepatan adalah cara lencana kecepatan langsung ditampilkan di peta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自転車速度の上書きにより、HSLのETAを調整します（Digitransitは遅めの自転車速度をデフォルトにします）。速度の単位は、地図上でライブ速度バッジを表示する方法です。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सायकलिंग वेग HSL ETAs ओव्हरराईड करतो (Digitransit डीफॉल्टने धीम्या सायकल वेगावर सेट असते). वेगाचे युनिट म्हणजे नकाशावर लाइव्ह-वेग बॅज कसा दाखवला जातो ते."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycling speed overrides HSL ETAs (Digitransit default na slow bike speed). Speed unit na how dem go show live-speed badge for map."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A velocidade de ciclismo substitui as estimativas de chegada da HSL (ETAs) (Digitransit usa uma velocidade de bicicleta lenta por padrão). A unidade de velocidade é como o crachá de velocidade em tempo real é exibido no mapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость для езды переопределяет ETA HSL (по умолчанию Digitransit использует медленную скорость для велосипеда). Единица скорости — это то, как на карте отображается бейдж текущей скорости."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائیکلنگ رفتار HSL کے ETA کو اوور رائیڈ کرتی ہے (Digitransit ڈیفالٹ طور پر سست بائیک رفتار استعمال کرتا ہے)۔ رفتار کی اکائی یہ ہے کہ نقشے پر لائیو رفتار بیج کیسے دکھایا جاتا ہے۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "骑行速度用于覆盖 HSL 的预计到达时间（ETAs）（Digitransit 默认使用较慢的骑行速度）。速度单位用于在地图上显示实时速度徽章。"
          }
        }
      }
    },
