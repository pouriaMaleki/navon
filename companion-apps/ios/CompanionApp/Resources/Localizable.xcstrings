    "home.rerouting": {
      "comment": "Label shown in the routing top card when an automatic reroute is in progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة التوجيه…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরায় রুট করা হচ্ছে…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
