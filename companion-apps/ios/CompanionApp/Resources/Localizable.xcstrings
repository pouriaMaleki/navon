    "pairing.scanInstruction": {
      "comment": "Instruction shown above the camera viewfinder during pairing.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع رمز QR في مركز الإطار وابقِه ثابتًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রেমের মধ্যে QR কোডটি কেন্দ্র করুন এবং স্থিরভাবে ধরে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentriere den QR-Code im Bild und halte ihn ruhig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center the QR code in the frame and hold steady."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Centra el código QR en el encuadre y mantén el dispositivo estable."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد QR را در مرکز کادر قرار دهید و ثابت نگه دارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohdista QR-koodi kuvan keskelle ja pidä se paikallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrez le code QR dans le cadre et maintenez-le stable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR कोड को फ्रेम के बीच में रखें और स्थिर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusatkan kode QR di dalam bingkai dan tahan dengan stabil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーム内でQRコードを中央に合わせ、動かさずに保持してください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR कोड फ्रेमच्या मध्यभागी ठेवा आणि स्थिर धरा."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Gbé QR code náà sí àárín fireemu, kí o dúró ṣinṣin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Centralize o código QR no quadro e mantenha-o estável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположите QR-код по центру кадра и держите устройство неподвижно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "QR کوڈ کو فریم کے بیچ میں رکھیں اور مستحکم رکھیں۔"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将二维码置于画面中央并保持稳定。"
          }
        }
      }
    },
