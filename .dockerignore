# Build context for device/emulator/web/Dockerfile.
# Everything excluded here is either a build output, a vendored dep, or
# IDE / editor noise — none of it belongs in the wasm-builder,
# emulator-builder, or companion-builder stages.

# Version control + CI metadata.
.git
.github

# Rust target dirs (root workspace + the per-crate firmware target).
**/target
.embuild

# Node module trees + JS build outputs. The npm-installing stages run
# `npm ci` against package-lock.json, so any host-side node_modules
# would just be wasted COPY bytes (and risk platform-mismatched binaries
# on Linux).
**/node_modules
**/dist
**/.next
**/.cache
**/playwright-report
**/test-results
companion-apps/web/e2e-results.json

# Android Gradle / IDE artifacts.
**/build
companion-apps/android/.gradle
companion-apps/android/.idea
companion-apps/android/local.properties
companion-apps/android/captures

# iOS Xcode / DerivedData / user-specific xcuserdata.
companion-apps/ios/DerivedData
**/xcuserdata
**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Firmware-side artifacts the wasm build doesn't need.
device/firmware/managed_components
device/firmware/dependencies.lock
device/firmware/sdkconfig.old

# Emulator-web outputs.
device/emulator/web/wasm-pkg

# OS / editor noise.
.DS_Store
.vscode
.idea
*.swp
npm-debug.log
yarn-error.log

# Plans + transient notes.
.xtask
