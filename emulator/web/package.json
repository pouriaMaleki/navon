{
  "name": "@esp32-screen/emulator",
  "private": false,
  "version": "0.1.0",
  "description": "Reusable web emulator framework for ESP32 projects using Waveshare ESP32-P4 LCD profiles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.8.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
