{
  "name": "ESP32 Rust Dev",
  "build": {
    "context": "..",
    "dockerfile": "../infra/devcontainer/Containerfile"
  },
  "initializeCommand": "bash infra/devcontainer/scripts/init-host-home.sh",
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "runArgs": [
    "--dns=1.1.1.1",
    "--dns=8.8.8.8",
    "--publish=5173:5173"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.devcontainer-homes/esp32-map,target=/home/vscode,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ],
  "remoteUser": "vscode",
  "containerEnv": {
    "CARGO_TARGET_DIR": "/work/target/devcontainer",
    "GIT_CONFIG_GLOBAL": "/home/vscode/.config/git/config",
    "TZ": "Europe/Helsinki",
    "LIBCLANG_PATH": "/usr/lib/llvm-14/lib"
  },
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server (emulator + companion)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash infra/devcontainer/scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.linkedProjects": [
          "/work/device/firmware/Cargo.toml"
        ],
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "ms-vscode.makefile-tools",
        "probe-rs.probe-rs-debugger",
        "fill-labs.dependi"
      ]
    }
  }
}
