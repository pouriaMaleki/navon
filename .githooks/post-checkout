#!/usr/bin/env bash
# Regenerate the iOS Xcode project after a branch checkout so the
# .xcodeproj (which is gitignored) stays in sync with the source tree.

# $3 == 1 means branch checkout; skip file checkouts.
[ "$3" = "1" ] || exit 0

if command -v xcodegen >/dev/null 2>&1 && [ -f companion-ios/project.yml ]; then
  echo "post-checkout: regenerating companion-ios Xcode project..."
  xcodegen generate --spec companion-ios/project.yml --project companion-ios
fi
